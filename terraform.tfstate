            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::013141018313:oidc-provider/oidc.eks.ap-south-1.amazonaws.com/id/F67CA82D971CA63A123B43206FE08455\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"oidc.eks.ap-south-1.amazonaws.com/id/F67CA82D971CA63A123B43206FE08455:aud\": \"sts.amazonaws.com\",\n          \"oidc.eks.ap-south-1.amazonaws.com/id/F67CA82D971CA63A123B43206FE08455:sub\": \"system:serviceaccount:kube-system:ebs-csi-controller-sa\"\n        }\n      }\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Principal\":{\"Federated\":\"arn:aws:iam::013141018313:oidc-provider/oidc.eks.ap-south-1.amazonaws.com/id/F67CA82D971CA63A123B43206FE08455\"},\"Condition\":{\"StringEquals\":{\"oidc.eks.ap-south-1.amazonaws.com/id/F67CA82D971CA63A123B43206FE08455:aud\":\"sts.amazonaws.com\",\"oidc.eks.ap-south-1.amazonaws.com/id/F67CA82D971CA63A123B43206FE08455:sub\":\"system:serviceaccount:kube-system:ebs-csi-controller-sa\"}}}]}",
